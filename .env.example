EXPO_PUBLIC_STRIPE_PRO_MONTHLY_LINK=https://buy.stripe.com/your-pro-monthly-link
EXPO_PUBLIC_STRIPE_PRO_YEARLY_LINK=https://buy.stripe.com/your-pro-yearly-link
